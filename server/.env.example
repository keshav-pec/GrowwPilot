# Copy this file to .env and fill in real values

NODE_ENV=development
PORT=5000

# From MongoDB Atlas: Database > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/growwpilot?retryWrites=true&w=majority

# Any long random string (at least 16 characters)
JWT_SECRET=change-me-to-a-long-random-string

# URL of the React app (Vite's default dev port)
CLIENT_ORIGIN=http://localhost:5173
