# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# From MongoDB Atlas: Database > Connect > Drivers. Keep the database name (/growwpilot) in the path.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/growwpilot?retryWrites=true&w=majority

# A long random string (at least 16 characters). In production use a new one, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# URL of the React app (Vite dev server locally, your Vercel URL in production)
CLIENT_ORIGIN=http://localhost:5173

# Number of proxies in front of the API: 1 locally / behind one proxy, 2 for Vercel -> Render
TRUST_PROXY=1

# --- Email (optional; see "Setting up email" in the README and mail-script/README.md) ---
# With none of these set, emails are printed in this terminal instead of being sent.
# Google Apps Script web app (/exec link) and the secret it checks (same as MAIL_SECRET in the script, 24+ characters)
MAIL_SCRIPT=
MAIL_SCRIPT_SECRET=
# Optional: a second script (on a second Gmail account) for password emails
MAIL_FORGOT_PASSWORD=
MAIL_SCRIPT_TIMEOUT_MS=30000
# Optional Gmail SMTP backup: your Gmail address and an app password (blocked on Render's free plan)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
# Most emails per 24 hours for the whole app (a free Gmail account sends about 100)
MAIL_DAILY_LIMIT=90
